---
interface Props {
  class?: string;
  tone?: 'mint' | 'coral' | 'lilac' | 'sky';
}

const { tone = 'mint', class: className } = Astro.props;

const tones = {
  mint: 'bg-mint text-ink',
  coral: 'bg-coral text-ink',
  lilac: 'bg-lilac text-ink',
  sky: 'bg-sky text-ink',
} as const;
---

<span
  class:list={['inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 font-display text-xs font-semibold', tones[tone], className]}
>
  <slot />
</span>