---
import { plans } from '../../data/plans';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const accentText: Record<string, string> = {
  mint: 'text-mint-deep',
  coral: 'text-coral-deep',
  lilac: 'text-lilac-deep',
};

const accentBg: Record<string, string> = {
  mint: 'bg-mint',
  coral: 'bg-coral',
  lilac: 'bg-lilac',
};
---

<Section id="precios" ariaLabelledBy="pricing-title">
  <div class="mb-14 max-w-2xl">
    <p class="mb-3 font-display text-sm font-semibold uppercase tracking-wide text-lilac-deep">Precios</p>
    <h2 id="pricing-title" class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      Dormir bien <span class="text-mint-deep">no debería costar un ojo</span>
    </h2>
  </div>

  <ul class="grid gap-6 md:grid-cols-3">
    {
      plans.map((p, index) => (
        <li data-reveal style={`--reveal-delay:${index * 90}ms`}>
          <div class:list={[p.featured ? 'neu-lg p-8' : 'neu p-8', 'relative flex h-full flex-col']}>
            {p.featured && (
              <span class:list={['absolute -top-4 left-1/2 -translate-x-1/2 rounded-full px-5 py-1.5 font-display text-xs font-bold text-ink shadow-soft', accentBg[p.accent]]}>
                Más popular
              </span>
            )}
            <h3 class="font-display text-lg font-bold tracking-tight text-ink">{p.name}</h3>
            <p class="mt-3">
              <span class="font-display text-5xl font-bold tracking-tight text-ink">{p.price}</span>
              <span class="text-sm text-ink/50"> / {p.period}</span>
            </p>
            <p class="mt-2 text-sm text-ink/60">{p.description}</p>
            <ul class="mt-6 flex-1 space-y-3">
              {
                p.features.map((f) => (
                  <li class="flex items-start gap-2.5 text-sm text-ink/75">
                    <span class:list={['mt-0.5 shrink-0', accentText[p.accent]]}>
                      <Icon name="check" size={16} strokeWidth={2.5} />
                    </span>
                    {f}
                  </li>
                ))
              }
            </ul>
            <Button href="#cta" tone={p.accent === 'mint' ? 'mint' : p.accent === 'coral' ? 'coral' : 'lilac'} class="mt-8 w-full">
              {p.cta}
            </Button>
          </div>
        </li>
      ))
    }
  </ul>
</Section>