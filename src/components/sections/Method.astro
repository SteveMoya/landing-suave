---
import { method } from '../../data/method';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';

const accentClasses: Record<string, string> = {
  mint: 'text-mint-deep',
  coral: 'text-coral-deep',
  lilac: 'text-lilac-deep',
  sky: 'text-sky',
};

const dotClasses: Record<string, string> = {
  mint: 'bg-mint-deep',
  coral: 'bg-coral-deep',
  lilac: 'bg-lilac-deep',
  sky: 'bg-sky',
};
---

<Section id="metodo" ariaLabelledBy="method-title" class="!pt-0">
  <div class="mx-auto mb-14 max-w-2xl text-center">
    <p class="mb-3 font-display text-sm font-semibold uppercase tracking-wide text-lilac-deep">Método</p>
    <h2 id="method-title" class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      Tu ritual en <span class="text-mint-deep">cuatro pasos suaves</span>
    </h2>
  </div>

  <!-- Vídeo de luna de fondo (Pixabay) en superficie neumórfica extruida (mucha luz) -->
  <div class="neu-lg relative mb-14 overflow-hidden">
    <video
      class="absolute inset-0 h-full w-full object-cover"
      src="/bg-moon.mp4"
      poster="/method-moon.jpg"
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
      aria-hidden="true"
    ></video>
    <!-- velo de luz suave neumórfico para legibilidad -->
    <div class="absolute inset-0 bg-gradient-to-br from-cream/60 via-cream/20 to-transparent" aria-hidden="true"></div>
    <div class="relative px-6 py-16 text-center sm:py-24">
      <span class="neu inline-block rounded-full px-5 py-2.5">
        <p class="font-display text-sm font-semibold text-ink/60">🌙 Un ritual en calma</p>
      </span>
      <h3 class="mt-5 font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
        Tu descanso, paso a paso
      </h3>
    </div>
  </div>

  <ol class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
    {
      method.map((step, index) => (
        <li data-reveal style={`--reveal-delay:${index * 90}ms`} class="relative">
          <div class="neu h-full p-6 text-center">
            <span class:list={['mx-auto grid h-16 w-16 place-items-center rounded-2xl font-display text-xl font-bold', accentClasses[step.accent]]}>
              <span class="neu grid h-16 w-16 place-items-center rounded-2xl">
                {step.num}
              </span>
            </span>
            <span class:list={['mx-auto mt-4 block h-1.5 w-10 rounded-full', dotClasses[step.accent]]} aria-hidden="true"></span>
            <h3 class="mt-3 font-display text-xl font-bold tracking-tight text-ink">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/60">{step.description}</p>
          </div>
          {index < method.length - 1 && (
            <span
              aria-hidden="true"
              class="absolute -right-4 top-1/2 z-10 hidden -translate-y-1/2 text-lilac-deep lg:block"
            >
              <Icon name="arrow-right" size={22} />
            </span>
          )}
        </li>
      ))
    }
  </ol>
</Section>