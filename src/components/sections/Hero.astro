---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
---

<section class="relative overflow-hidden pt-28 md:pt-36">
  <!-- manchas suaves de color -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div class="absolute -left-24 -top-24 h-[420px] w-[420px] rounded-full bg-lilac/30 blur-[110px]"></div>
    <div class="absolute right-[-100px] top-1/3 h-[380px] w-[380px] rounded-full bg-mint/25 blur-[110px]"></div>
    <div class="absolute bottom-0 left-1/3 h-[300px] w-[300px] rounded-full bg-coral/20 blur-[100px]"></div>
  </div>

  <div class="container-suave relative grid items-center gap-16 pb-24 lg:grid-cols-2 lg:pb-32">
    <div data-reveal>
      <Badge tone="lilac" class="mb-6">🌙 {site.hero.badge}</Badge>
      <h1 class="font-display text-5xl font-bold leading-[1.08] tracking-tight sm:text-6xl lg:text-7xl">
        {site.hero.title.start}
        <span class="text-mint-deep">{site.hero.title.accent}</span>
      </h1>
      <p class="mt-6 max-w-lg text-lg leading-relaxed text-ink/70">{site.hero.subtitle}</p>
      <div class="mt-9 flex flex-col gap-4 sm:flex-row">
        <Button href="#cta" tone="mint" size="lg">
          <Icon name="moon" size={18} />
          {site.hero.primaryCta}
        </Button>
        <Button href="#metodo" tone="lilac" size="lg">
          {site.hero.secondaryCta}
        </Button>
      </div>

      <dl data-reveal style="--reveal-delay:150ms" class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
        {
          site.stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-2xl font-bold tracking-tight text-ink">{s.value}</dd>
              <dd class="text-xs text-ink/50">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- Mockup de la app de sueño (neumorfismo puro) -->
    <div data-reveal style="--reveal-delay:120ms" class="relative mx-auto w-full max-w-sm">
      <div class="neu-lg relative overflow-hidden p-6">
        <!-- header de la app -->
        <div class="flex items-center justify-between">
          <div>
            <p class="font-display text-xs font-semibold text-ink/50">Buenas noches, Camila</p>
            <p class="font-display text-lg font-bold text-ink">Tu ritual empieza en 5 min</p>
          </div>
          <span class="neu grid h-11 w-11 place-items-center rounded-2xl text-mint-deep">
            <Icon name="moon" size={20} />
          </span>
        </div>

        <!-- olas de sueño -->
        <div class="neu-pressed mt-5 rounded-3xl p-5">
          <div class="flex items-center justify-between">
            <p class="font-display text-xs font-semibold text-ink/50">Respiraciones guiadas</p>
            <span class="neu-pressed grid h-9 w-9 place-items-center rounded-xl text-coral-deep">
              <Icon name="play" size={16} />
            </span>
          </div>
          <div class="mt-4 flex h-16 items-end justify-between gap-1.5" aria-hidden="true">
            {[35, 60, 80, 55, 90, 70, 45, 75, 100, 65, 85, 50, 95, 60, 40, 80, 70, 55, 90, 65].map((h, i) => (
              <span class:list={[
                'w-full rounded-full',
                i === 10 ? 'bg-mint opacity-100' : 'bg-mint/35',
              ]} style={`height:${h}%`} />
            ))}
          </div>
          <p class="mt-3 text-center font-display text-[11px] font-semibold text-ink/40">
            8:00 → 8:20 · 20 minutos suaves
          </p>
        </div>

        <!-- sonido y timer -->
        <div class="mt-5 grid grid-cols-2 gap-5">
          <button type="button" class="neu-pressed rounded-3xl p-4 text-left" aria-label="Sonido actual: Lluvia suave">
            <span class="neu grid h-10 w-10 place-items-center rounded-xl text-lilac-deep">
              <Icon name="headphones" size={18} />
            </span>
            <p class="mt-3 font-display text-sm font-bold text-ink">Lluvia suave</p>
            <p class="text-[11px] text-ink/50">Sonido ambiental</p>
          </button>
          <button type="button" class="neu-pressed rounded-3xl p-4 text-left" aria-label="Temporizador: 60 minutos">
            <span class="neu grid h-10 w-10 place-items-center rounded-xl text-coral-deep">
              <Icon name="clock" size={18} />
            </span>
            <p class="mt-3 font-display text-sm font-bold text-ink">60 min</p>
            <p class="text-[11px] text-ink/50">Apaga solo</p>
          </button>
        </div>

        <!-- toggle de noche -->
        <div class="mt-5 flex items-center justify-between pb-1">
          <div>
            <p class="font-display text-sm font-bold text-ink">Modo noche</p>
            <p class="text-[11px] text-ink/50">Reduce luz y sonidos</p>
          </div>
          <button type="button" class="neu-toggle-track" role="switch" aria-checked="true" aria-label="Modo noche activado">
            <span class="neu-toggle-thumb" style="left: 0.625rem;"></span>
          </button>
        </div>
      </div>

      <!-- chip flotante de progreso -->
      <div class="neu absolute -right-3 top-1/4 -translate-y-1/2 rounded-2xl px-4 py-3 sm:-right-6">
        <p class="font-display text-[11px] font-semibold text-ink/50">Racha</p>
        <p class="font-display text-xl font-bold text-mint-deep">12 noches ✨</p>
      </div>
    </div>
  </div>
</section>