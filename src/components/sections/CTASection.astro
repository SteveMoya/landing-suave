---
import { site } from '../../data/site';
import Section from '../ui/Section.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="cta" ariaLabelledBy="cta-title">
  <div class="neu-lg relative overflow-hidden px-6 py-16 text-center sm:px-16">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0">
      <div class="absolute -left-20 -top-20 h-64 w-64 rounded-full bg-lilac/25 blur-[70px]"></div>
      <div class="absolute -bottom-24 -right-16 h-72 w-72 rounded-full bg-mint/25 blur-[80px]"></div>
    </div>

    <div class="relative mx-auto max-w-xl">
      <span class="neu mx-auto mb-6 grid h-20 w-20 place-items-center rounded-3xl text-mint-deep">
        <Icon name="moon" size={32} />
      </span>
      <h2 id="cta-title" class="font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        Esta noche, <span class="text-mint-deep">descansa de verdad</span>
      </h2>
      <p class="mt-4 text-lg text-ink/70">
        Empieza gratis en un minuto. Sin tarjeta, sin compromisos, sin letra pequeña.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="#"
          class="neu-btn px-10 py-4 font-display text-lg font-semibold text-mint-deep"
        >
          <Icon name="play" size={18} />
          Probar 7 noches gratis
        </a>
        <a href="#precios" class="font-display text-sm font-semibold text-lilac-deep underline-offset-4 hover:underline">
          Ver precios
        </a>
      </div>

      <form data-newsletter-form class="mx-auto mt-14 max-w-md" novalidate>
        <p class="mb-3 font-display text-sm font-bold text-ink">{site.newsletter.title}</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <label for="newsletter-email" class="sr-only">Correo electrónico</label>
          <input
            id="newsletter-email"
            name="email"
            type="email"
            required
            placeholder={site.newsletter.placeholder}
            class="neu-pressed w-full rounded-full px-5 py-3.5 text-sm text-ink placeholder:text-ink/40 focus:outline-lilac-deep"
          />
          <button
            type="submit"
            class="neu-btn shrink-0 px-7 py-3.5 font-display text-sm font-bold text-coral-deep"
          >
            {site.newsletter.button}
          </button>
        </div>
        <p data-newsletter-status class="mt-3 min-h-5 font-display text-sm font-semibold" data-success={site.newsletter.success} aria-live="polite"></p>
      </form>
    </div>
  </div>
</Section>

<script>
  import { initNewsletter } from '../../scripts/newsletter';

  initNewsletter();
</script>