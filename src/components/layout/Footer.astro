---
import { site } from '../../data/site';
import Logo from '../brand/Logo.astro';
import Icon from '../ui/Icon.astro';
---

<footer class="pb-12 pt-6">
  <div class="container-suave">
    <div class="neu rounded-[2.5rem] p-8 md:p-12">
      <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
        <div class="flex flex-col gap-5">
          <Logo />
          <p class="max-w-xs text-sm leading-relaxed text-ink/60">
            {site.description}
          </p>
          <div class="flex gap-3">
            {
              site.socials.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={s.name}
                  class="neu grid h-10 w-10 place-items-center rounded-xl text-ink/60 transition-all duration-200 hover:text-mint-deep"
                >
                  <Icon name={s.icon} size={16} />
                </a>
              ))
            }
          </div>
        </div>

        <nav aria-label="Explorar">
          <h3 class="mb-4 font-display text-sm font-semibold text-ink/60">Explorar</h3>
          <ul class="space-y-3">
            {
              site.nav.map((item) => (
                <li>
                  <a href={item.href} class="text-sm text-ink/70 transition-colors hover:text-mint-deep">
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="flex flex-col gap-4">
          <h3 class="font-display text-sm font-semibold text-ink/60">Contacto</h3>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex items-center gap-2 text-sm text-ink/70 transition-colors hover:text-mint-deep"
          >
            <Icon name="mail" size={16} class="text-ink/50" />
            {site.email}
          </a>
          <p class="max-w-[220px] text-xs leading-relaxed text-ink/50">
            Soporte humano que también duerme… pero responde antes de tu café. ☕
          </p>
        </div>

        <div>
          <h3 class="mb-4 font-display text-sm font-semibold text-ink/60">Noches de Suave</h3>
          <span class="neu-pressed inline-flex items-center gap-2.5 rounded-2xl px-4 py-3 text-sm font-semibold text-ink">
            <span class="h-2.5 w-2.5 rounded-full bg-mint-deep" aria-hidden="true"></span>
            {new Date().getHours() < 6 ? 'Buenas noches. Descansa.' : new Date().getHours() < 12 ? 'Buenos días. Ya has descansado.' : new Date().getHours() < 20 ? 'Buenas tardes. Guarda energía.' : 'Buenas noches. Empieza tu ritual.'}
          </span>
        </div>
      </div>

      <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-ink/10 pt-8 text-xs text-ink/50 sm:flex-row">
        <p>© {new Date().getFullYear()} {site.name}. Duerme bien, vive mejor.</p>
        <div class="flex gap-6">
          <a href={site.legal.privacy} class="transition-colors hover:text-mint-deep">Privacidad</a>
          <a href={site.legal.terms} class="transition-colors hover:text-mint-deep">Términos</a>
        </div>
      </div>
    </div>
  </div>
</footer>