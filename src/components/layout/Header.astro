---
import { site } from '../../data/site';
import Logo from '../brand/Logo.astro';
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<header data-header class="fixed inset-x-0 top-0 z-50">
  <div class="container-suave flex h-16 items-center justify-between rounded-b-3xl md:h-20">
    <Logo />

    <Navigation class="hidden lg:flex" />

    <div class="flex items-center gap-3">
      <Button href="#precios" tone="lilac" size="sm" class="hidden sm:inline-flex">
        Iniciar sesión
      </Button>
      <Button href="#cta" tone="mint" size="sm" class="hidden sm:inline-flex">
        Descansar gratis
      </Button>
      <button
        data-menu-button
        type="button"
        class="neu grid h-11 w-11 place-items-center rounded-2xl text-ink lg:hidden"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <MobileMenu />
</header>

<script>
  import { initHeader } from '../../scripts/header';

  initHeader();
</script>