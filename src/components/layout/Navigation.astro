---
import { site } from '../../data/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<nav class:list={['items-center gap-7', className]} aria-label="Navegación principal">
  {
    site.nav.map((item) => (
      <a
        href={item.href}
        class="font-display text-sm font-semibold text-ink/70 transition-colors duration-200 hover:text-mint-deep"
      >
        {item.label}
      </a>
    ))
  }
</nav>